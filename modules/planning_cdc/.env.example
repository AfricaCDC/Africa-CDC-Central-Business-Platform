# ─────────────────────────────────────────────────────────────
# RBM Platform — Environment Variables (master example)
# Copy this file to .env and replace every CHANGE_ME placeholder.
# Validate with: bash scripts/validate-env.sh .env
# ─────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost
LOG_LEVEL=info
# Error detail exposure (packages/lib/errors.js). Raw SQL messages and stack
# traces reach the client ONLY in NODE_ENV=development/test. Overrides:
# HIDE_DB_ERRORS=1 forces sanitized errors even in dev; DEBUG_ERRORS=1
# re-enables raw detail anywhere (temporary debugging only — never leave on).
# HIDE_DB_ERRORS=
# DEBUG_ERRORS=

# ── Database (MySQL 8) ───────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_USER=rbm_user
DB_PASSWORD=CHANGE_ME_db_password_min_8_chars
DB_NAME=rbm_platform
DB_ROOT_PASSWORD=CHANGE_ME_root_password_min_8_chars
DB_SSL=false
# Host port to expose for tooling (only used in dev compose)
DB_PORT_EXPOSED=3306

# ── Redis Cache ──────────────────────────────────────────────
REDIS_URL=redis://cache:6379
REDIS_PORT_EXPOSED=6379

# ── JWT Authentication ───────────────────────────────────────
# Generate strong secrets:
#   openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars___________
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars__________
# An access token cannot be revoked before it expires (a disabled user or a
# stolen token keeps working until then): keep it short. The web app refreshes
# silently, so users do not notice (D-20261108-02).
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# ── API Server ───────────────────────────────────────────────
API_SERVER_PORT=4000
CORS_ORIGINS=http://localhost:5000,http://localhost:5173
# Set to "true" only on the rare occasion you want the entrypoint
# to skip migrations on container boot.
SKIP_MIGRATIONS=false

# ── API Gateway (Nginx) ──────────────────────────────────────
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# ── Web App (Vite) ───────────────────────────────────────────
WEB_APP_PORT=5000
# Build-time URL prefix of the SPA. "/" = standalone (own host). Embedded in the
# CBP behind Apache, which strips the prefix: /staff/planning/ (leading and
# trailing slash). Rebuild web-app after a change.
VITE_BASE_PATH=/
# Leave empty: the API is then <VITE_BASE_PATH>api. Set only for an API on another origin.
VITE_API_URL=
# Address of the RBM team shown on the sign-in page (Request access, Contact).
# Empty = those links are hidden. Build-time: rebuild web-app after a change.
VITE_SUPPORT_EMAIL=

# ── Notification Service ─────────────────────────────────────
# Africa CDC SMTP — implicit SSL on port 465 (notification-service auto-detects
# secure mode when SMTP_PORT=465).
NOTIFICATION_SERVICE_PORT=3005
SMTP_HOST=mail.africacdc.net
SMTP_PORT=465
SMTP_USER=notifications@africacdc.net
SMTP_PASS=CHANGE_ME
SMTP_FROM="Africa CDC RBM Platform <notifications@africacdc.net>"
# Email transport driver: smtp (default) | graph | composite (Graph primary,
# SMTP fallback). 'graph'/'composite' reuse the SSO Entra App Registration
# (MS_TENANT_ID/MS_CLIENT_ID/MS_CLIENT_SECRET) and require the Mail.Send
# application permission with admin consent. GRAPH_FROM defaults to SMTP_FROM
# but MUST be a real tenant mailbox (Graph posts to /users/<addr>/sendMail —
# an alias like noreply@ returns 404 ErrorInvalidUser). Prod uses
# notifications@africacdc.org (same mailbox as PHAHM).
EMAIL_DRIVER=smtp
# GRAPH_FROM="Africa CDC RBM <notifications@africacdc.org>"
# Note: the notification-service also needs DB_HOST/DB_PORT/DB_USER/
# DB_PASSWORD/DB_NAME (injected by docker-compose) — its outbox worker reads
# notification_outbox from MySQL (D-20260817-01).
# Optional: incoming IMAP if/when an inbox parser is added
# IMAP_HOST=mail.africacdc.net
# IMAP_PORT=993
# IMAP_USE_SSL=true

# NOTE: reporting reminder schedulers (draft + quarter-deadline) are NOT
# env-configured — they are admin-managed in the `app_settings` table via
# /admin/settings (keys `reminders.draft.*` / `reminders.deadline.*`).

# ── Sync Service ─────────────────────────────────────────────
SYNC_SERVICE_PORT=3006
CBP_API_URL=
# CBP staff import (api-server). The endpoints carry CBP's share token: set
# them here, never in code. Basic credentials are separate.
CBP_BASE_URL=https://cbp.africacdc.org
# CBP Staff Portal SSO (D-20261110-01): POST /api/auth/cbp/accept verifies the
# HS256 token the portal sends. MUST equal the JWT_SECRET of the CBP root .env.
# Empty = feature off (404).
CBP_SSO_JWT_SECRET=
# Embedded in the CBP (Apache proxies https://<cbp-host>/staff/planning/* here
# and strips the prefix), also set:
#   VITE_BASE_PATH=/staff/planning/
#   APP_BASE_URL=https://<cbp-host>/staff/planning
#   MS_REDIRECT_URI=https://<cbp-host>/staff/planning/api/auth/microsoft/callback
# CBP_BASE_URL keeps the public CBP URL: only the gateway joins the CBP network.
CBP_STAFF_ENDPOINT=
CBP_DIVISIONS_ENDPOINT=
CBP_AUTH_USERNAME=
CBP_AUTH_PASSWORD=
CBP_API_KEY=
SYNC_SERVICE_TOKEN=
CBP_SYNC_CRON=0 2 * * *
AMERT_SYNC_CRON=0 3 * * 1
ENABLE_CRON=true

# ── Admin contact (used by audit/incident-response middleware) ──
ADMIN_EMAILS=admin@africacdc.org

# ── Power Automate (means-of-verification uploads → SharePoint) ──
# SECRET: the flow URL embeds a SAS `sig` token granting writes into the
# Africa CDC SharePoint. Never commit it (D-20260818-02 — the previous value
# was hardcoded in routes/reporting/evidenceRoutes.js and had to be regenerated in Azure).
# Without this variable the upload endpoint returns 503 instead of storing.
POWER_AUTOMATE_URL=
