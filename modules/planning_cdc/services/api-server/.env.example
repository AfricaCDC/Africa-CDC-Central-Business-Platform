NODE_ENV=production
PORT=4000

# Database (MySQL)
DB_HOST=your-db-host.com
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=rbm_platform
DB_SSL=true

# Auth (JWT) — both must be ≥32 chars and DIFFERENT in prod
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars___________
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars__________
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# CORS - comma-separated frontend URLs
CORS_ORIGINS=https://your-frontend.vercel.app

# Rate limiting (optional overrides)
RATE_LIMIT_ADMIN_MAX=60
RATE_LIMIT_GENERAL_MAX=300

# Service-to-service auth (D-07). Shared across api-server, sync-service,
# notification-service. Signs + verifies JWTs carrying a `svc` claim.
# Generate with: openssl rand -hex 32
SERVICE_TOKEN_SECRET=CHANGE_ME_service_secret_min_32_chars_________

# Downstream service URLs (default to localhost for dev)
NOTIFICATION_SERVICE_URL=http://localhost:3005
