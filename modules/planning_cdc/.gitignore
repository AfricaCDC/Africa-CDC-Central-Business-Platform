# ═══════════════════════════════════════════════════════════════
# Planning CDC — repo root .gitignore
# ═══════════════════════════════════════════════════════════════

# Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Build output
dist/
build/
out/
.next/
.nuxt/
.cache/
.vite/
**/dist/
**/build/

# Environment & secrets — NEVER commit
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Secrets, keys, credentials
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
cookies.txt

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Test & coverage
coverage/
*.lcov
.nyc_output/
.jest/

# Docker / runtime
.docker/
docker-compose.override.yml

# Database dumps & backups
backups/
*.sql.gz
*.sql.bz2
db-backups/

# Upload directories (api-server evidenceRoutes local storage)
uploads/
**/uploads/

# Temp files
*.tmp
*.temp
.tmp/
tmp/

# Excel imports (large, data-specific, not for git)
*.xlsx
*.xls
!**/docs/**/*.xlsx
!**/docs/**/*.xls

# Replit / editor-specific artifacts
.replit
replit.nix
.breakpoints

# Playwright MCP screenshots/snapshots (noise)
.playwright-mcp/
playwright-report/
test-results/

# Claude Code session artifacts
.claude/
tool-results/

# Python (for any scripts that may use it)
__pycache__/
*.pyc
*.pyo

# OS
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
doc.doc
*.doc
*.docx
*.pdf
# User guides served by the web app (copied from docs/manual, D-20261105-03)
!services/web-app/public/guides/*.pdf

.playwright-mcp/
# Host-local deploy state — written by scripts/deploy-staging.sh, never committed
.last-deploy-ref
